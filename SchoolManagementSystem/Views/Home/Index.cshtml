@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to School Management System</h1>
    <p class="lead">Manage tasks, users, and reports all in one place.</p>

    <div class="mt-4">
        <a asp-controller="Tasks" asp-action="Index" class="btn btn-primary btn-lg">View Tasks</a>
        <a asp-controller="Tasks" asp-action="Create" class="btn btn-success btn-lg">Create New Task</a>
    </div>
</div>
