@model SchoolManagementSystem.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
    Layout = "_Layout";
}

<h1>Delete Task</h1>

<h3>Are you sure you want to delete this task?</h3>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">@Model.Description</p>
        <p>Status: @(Model.IsCompleted ? "Completed" : "Pending")</p>
        <p>User: @(Model.User?.Email ?? "No user assigned")</p>
    </div>
</div>

<form asp-controller="Tasks" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger mt-3">Delete</button>
    <a asp-controller="Tasks" asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
